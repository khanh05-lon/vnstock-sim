# ===== Cấu hình chạy bằng docker compose =====
# Sao chép thành .env (cùng thư mục docker-compose.yml) rồi điền giá trị:  cp .env.docker.example .env
# Tạo chuỗi ngẫu nhiên:  openssl rand -hex 32

# --- Tên miền & địa chỉ công khai (Caddy tự xin chứng chỉ HTTPS cho DOMAIN) ---
DOMAIN=vncoin.example.com
PUBLIC_URL=https://vncoin.example.com
CORS_ORIGIN=https://vncoin.example.com

# --- Bí mật (BẮT BUỘC đổi) ---
POSTGRES_PASSWORD=doi-thanh-chuoi-ngau-nhien
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Mã hoá khoá 2FA trong CSDL — mất/đổi khoá thì người dùng phải bật lại 2FA
DATA_ENCRYPTION_KEY=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# --- Tài khoản quản trị tạo lần đầu (đổi mật khẩu ngay sau khi đăng nhập) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-manh

# --- Thị trường ---
# binance (giá thật từ Binance, tự chuyển sang giả lập khi mất kết nối) | sim (chỉ giả lập, chạy offline)
MARKET_FEED=binance

# --- Email (SMTP) — để trống thì nội dung email chỉ ghi ra log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VNCoin <no-reply@vncoin.example.com>
# Bắt buộc xác thực email trước khi đặt lệnh
REQUIRE_EMAIL_VERIFICATION=true

# --- Trợ lý AI trong hộp chat hỗ trợ (Claude API) — để trống thì tắt, khách chỉ nhắn nhân viên ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# --- Giám sát & cảnh báo ---
# Token đọc /api/metrics (Prometheus); để trống = tắt endpoint ở production
METRICS_TOKEN=
# Email nhận cảnh báo (phân tách bằng dấu phẩy)
ALERT_EMAILS=
# Webhook nhận cảnh báo (Slack / Discord / Telegram bot sendMessage?chat_id=...)
ALERT_WEBHOOK_URL=

# --- Tài khoản demo dùng chung (để trống ở production thật) ---
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Sao lưu (khi chạy --profile backup) ---
BACKUP_KEEP_DAYS=14
