{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vnstock-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/VS-CODE/vnstock-sim/backend",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "vnstock-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/VS-CODE/vnstock-sim/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "vnstock-data",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "D:/VS-CODE/vnstock-sim/data-service/run.mjs"
      ],
      "port": 8001
    }
  ]
}
