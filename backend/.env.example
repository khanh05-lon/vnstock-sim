# Cổng API
PORT=4000
# Origin của frontend (CORS)
CORS_ORIGIN=http://localhost:5173
# Khoá ký JWT — đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=change-me-to-a-long-random-string
# Thư mục lưu PostgreSQL nhúng (PGlite)
DATA_DIR=./data/pgdata
# Nguồn dữ liệu thị trường:
#   binance — giá, sổ lệnh, giao dịch thật từ Binance (API công khai, không cần khoá);
#             mất kết nối quá BINANCE_SIM_AFTER_MS thì tự chuyển sang giả lập
#   sim     — chỉ giả lập quanh giá đóng gói sẵn (chạy offline, test)
MARKET_FEED=binance
# REST công khai của Binance, thử lần lượt (cách nhau dấu phẩy)
# BINANCE_REST_URLS=https://data-api.binance.vision,https://api.binance.com
# WebSocket dữ liệu thị trường
# BINANCE_WS_URL=wss://data-stream.binance.vision
# Mất dữ liệu thật quá lâu (ms) thì chuyển sang giả lập
# BINANCE_SIM_AFTER_MS=5000
# Chu kỳ khớp lệnh chờ và phát dữ liệu cho client (ms)
# MARKET_FLUSH_MS=200
# Tài khoản demo được seed sẵn (chỉ dùng cho môi trường dev)
DEMO_EMAIL=demo@vncoin.local
DEMO_PASSWORD=demo12345

# Tài khoản quản trị được tạo khi khởi động (bắt buộc đặt khi NODE_ENV=production; dev dùng giá trị mẫu dưới đây)
ADMIN_EMAIL=admin@vncoin.local
ADMIN_PASSWORD=admin12345

# ── CSDL ─────────────────────────────────────────────────────────────
# Có DATABASE_URL → dùng PostgreSQL thật thay PGlite (DATA_DIR bị bỏ qua)
# DATABASE_URL=postgres://vnstock:matkhau@localhost:5432/vnstock
# DB_POOL_MAX=10
# MIGRATE_ON_START=true

# ── Bảo mật tài khoản & email ────────────────────────────────────────
# Địa chỉ web công khai, dùng tạo link trong email (bắt buộc khi NODE_ENV=production)
# PUBLIC_URL=http://localhost:5173
# Khoá mã hoá khoá bí mật 2FA trong CSDL (≥ 32 ký tự). Mất khoá → người dùng phải bật lại 2FA.
# Để trống ở dev: khoá 2FA lưu dạng thô (có cảnh báo khi production)
# DATA_ENCRYPTION_KEY=
# true = phải xác thực email mới được đặt lệnh
REQUIRE_EMAIL_VERIFICATION=false
# Nhân viên (quản trị, CSKH) phải bật xác thực 2 lớp mới vào được khu vực nhân viên (mặc định: bật ở production, tắt ở dev)
# REQUIRE_STAFF_2FA=true
# Điều chỉnh số dư có giá trị từ mức này (USDT) trở lên phải có quản trị viên thứ hai duyệt
ADJUST_APPROVAL_USDT=1000
# Trưởng nhóm CSKH được duyệt bồi hoàn (khoản cộng do CSKH đề xuất) tới mức này (USDT); lớn hơn thì Tài chính duyệt
SUPPORT_COMP_LIMIT_USDT=100
# Chỉnh giá lệch quá mức này (%, so với giá hiện tại hoặc giá Binance) phải có người thứ hai duyệt
PRICE_APPROVAL_PCT=5
# CHỈ môi trường dev: tạo sẵn tài khoản nhân viên thử mỗi vai trò, cùng tên miền với ADMIN_EMAIL
# (admin2@, ops@, finance@, finance2@, risk@, compliance@, compliance2@, mlro@, p2p@, dpo@, audit@, cskh@, cskhlead@) để thử phân quyền và duyệt 2 người.
# Không có tác dụng khi NODE_ENV=production.
DEV_STAFF_PASSWORD=staff12345
# SMTP — để trống thì nội dung email (xác thực, đặt lại mật khẩu, cảnh báo) chỉ ghi ra log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="VNCoin <no-reply@example.com>"

# ── Vận hành ─────────────────────────────────────────────────────────
# Số proxy đứng trước app (1 khi chạy sau Caddy/Nginx) để lấy đúng IP người dùng
# TRUST_PROXY=1
# Thư mục build giao diện để API phục vụ luôn SPA (production)
# FRONTEND_DIST=../frontend/dist
# Giới hạn tần suất mỗi IP / mỗi người dùng
# RATE_LIMIT_API_PER_MIN=600
# RATE_LIMIT_ORDERS_PER_MIN=120
# Nơi ghi bản sao lưu tự động trước khi khôi phục dữ liệu từ trang Quản trị
BACKUP_DIR=./data/backups
# Bật /api/metrics (Prometheus) — gửi kèm header Authorization: Bearer <token>
# METRICS_TOKEN=
# Nơi nhận cảnh báo vận hành (cách nhau dấu phẩy) và webhook Slack / Discord / Telegram
# ALERT_EMAILS=ops@example.com
# ALERT_WEBHOOK_URL=
# Ngưỡng cảnh báo
# ALERT_EVENT_LOOP_MS=500
# ALERT_P95_MS=2000
# ALERT_RSS_MB=1500
# ALERT_DB_SLOW_MS=1000
# ALERT_ERROR_RATE_PCT=5

# ── Trợ lý AI trong hộp chat hỗ trợ (Claude API) ─────────────────────
# Khoá API tạo ở https://console.anthropic.com (tính phí theo lượt dùng).
# Để trống: tắt trợ lý AI, hộp chat chỉ nhắn được nhân viên CSKH.
# ANTHROPIC_API_KEY=
# Model trả lời khách (mặc định claude-haiku-5-5: nhanh, rẻ)
# AI_MODEL=claude-haiku-5-5
